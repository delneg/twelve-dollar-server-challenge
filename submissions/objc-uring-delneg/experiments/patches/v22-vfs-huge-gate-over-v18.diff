+    int rc = tdw_flush(w);
+    w->pageAt = 0;
+    return rc ? rc : w->real->pMethods->xTruncate(w->real, size);
+}
+static int tdw_sync(sqlite3_file *f, int flags) {
+    TDWalFile *w = (TDWalFile *)f;
+    int rc = tdw_flush(w);
+    return rc ? rc : w->real->pMethods->xSync(w->real, flags);
