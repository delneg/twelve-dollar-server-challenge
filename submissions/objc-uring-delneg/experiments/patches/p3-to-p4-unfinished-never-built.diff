 // ---------------------------------------------------------------- helpers
 TD_INLINE bool ieq(const char *a, const char *lower, uint32_t n) {
@@ -170,7 +171,7 @@
     int64_t lastStats;
     TDAuth *auth;
     int64_t started, now;
