<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <AssemblyName>Server</AssemblyName>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>disable</Nullable>
    <!-- One core: no background GC thread competing with requests. -->
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <InvariantGlobalization>true</InvariantGlobalization>
    <UseSystemResourceKeys>true</UseSystemResourceKeys>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <PublishReadyToRun>true</PublishReadyToRun>
    <TieredPGO>true</TieredPGO>
    <EnableDefaultContentItems>false</EnableDefaultContentItems>
  </PropertyGroup>
  <!-- Transport.fs: struct epoll_event is packed (12 bytes) on x86-64 but not on aarch64 (16 bytes). Pick the
       layout from the target RID (build.sh passes the current one), else the SDK's own. Any other RID keeps the
       x86-64 source unchanged, and Transport.supported turns the transport off where the layout does not fit. -->
  <PropertyGroup>
    <EpollRid>$(RuntimeIdentifier)</EpollRid>
    <EpollRid Condition="'$(EpollRid)' == ''">$(NETCoreSdkRuntimeIdentifier)</EpollRid>
    <DefineConstants Condition="$(EpollRid.EndsWith('-arm64'))">$(DefineConstants);EPOLL_ARM64</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Sqlite.fs" />
    <Compile Include="Db.fs" />
    <Compile Include="Auth.fs" />
    <Compile Include="Api.fs" />
    <Compile Include="Conn.fs" />
    <Compile Include="Transport.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Update="FSharp.Core" Version="11.0.101-rc2.26504.105" />
  </ItemGroup>
</Project>
